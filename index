          { label: "info@horst-malerbetriebe.de", href: "mailto:info@horst-malerbetriebe.de" }
        ]},
        { title: "Navigation", items: [
          { label: "Startseite", href: "#top" },
          { label: "Leistungen", href: this.X("leistungen") },
          { label: "Projekte", href: this.PROJ },
          { label: "Oberflächenkultur", href: this.X("oberflaechenkultur") },
          { label: "Über uns", href: this.X("ueber-uns") },
          { label: "Impressionen", href: this.X("impressionen") },
          { label: "Karriere", href: this.X("karriere") },
          { label: "Kontakt", href: "#kontakt" }
        ]},
        { title: "Informationen", items: [
          { label: "Impressum", href: this.X("impressum") },
          { label: "Datenschutz", href: this.X("datenschutz") }
        ]},
        { title: "Links", items: [
          this.ext("Instagram", "instagram"),
          this.ext("Facebook", "facebook"),
          this.ext("TikTok", "tiktok"),
          this.ext("LinkedIn", "linkedin"),
          this.ext("Google", "google")
        ]}
      ]),

      topics: topicList.map((label) => {
        const on = st.topic === label;
        return {
          label,
          bg: on ? "#15123B" : "var(--paper)",
          fg: on ? "#fff" : "#17171C",
          border: on ? "#15123B" : "var(--line-3)",
          onPick: () => this.setState({ topic: label })
        };
      }),
      fName: st.name, fEmail: st.email, fPhone: st.phone, fPlace: st.place,
      fMessage: st.message, fPrivacy: st.privacy,
      setName: (e) => this.setState({ name: e.target.value }),
      setEmail: (e) => this.setState({ email: e.target.value }),
      setPhone: (e) => this.setState({ phone: e.target.value }),
      setPlace: (e) => this.setState({ place: e.target.value }),
      setMessage: (e) => this.setState({ message: e.target.value }),
      togglePrivacy: (e) => this.setState({ privacy: e.target.checked }),
      formSent: st.sent,
      formOpen: !st.sent,
      formError: !!st.error,
      formErrorText: st.error,
      resetForm: () => this.setState({ sent: false, name: "", email: "", phone: "", place: "", message: "", privacy: false, error: "" }),
      submitForm: (e) => {
        e.preventDefault();
        if (!st.name.trim() || !st.email.trim() || !st.message.trim()) {
          this.setState({ error: "Bitte Name, E-Mail und Nachricht ausfüllen." }); return;
        }
        if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(st.email.trim())) {
          this.setState({ error: "Bitte eine gültige E-Mail-Adresse angeben." }); return;
        }
        if (!st.privacy) { this.setState({ error: "Bitte der Datenschutzerklärung zustimmen." }); return; }
        this.setState({ error: "", sent: true });
      }
    };
  }
}
