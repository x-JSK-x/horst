      ],

      services,
      allServicesHref: this.X("leistungen"),
      ueberHref: this.X("ueber-uns"),
      activeServiceLabel: rawServices[st.activeService].title,

      r1Tf: rf[0].tf, r1Op: rf[0].op, r1Z: rf[0].z, r1Pe: rf[0].pe, r1Tr: rf[0].tr,
      r2Tf: rf[1].tf, r2Op: rf[1].op, r2Z: rf[1].z, r2Pe: rf[1].pe, r2Tr: rf[1].tr,
      r3Tf: rf[2].tf, r3Op: rf[2].op, r3Z: rf[2].z, r3Pe: rf[2].pe, r3Tr: rf[2].tr,
      t1Size: rf[0].tickSize, t1Weight: rf[0].tickWeight, t1Color: rf[0].tickColor, t1Op: rf[0].tickOpacity, t1Go: rf[0].go,
      t2Size: rf[1].tickSize, t2Weight: rf[1].tickWeight, t2Color: rf[1].tickColor, t2Op: rf[1].tickOpacity, t2Go: rf[1].go,
      t3Size: rf[2].tickSize, t3Weight: rf[2].tickWeight, t3Color: rf[2].tickColor, t3Op: rf[2].tickOpacity, t3Go: rf[2].go,
      refCounter: String(Math.min(3, (st.refManual !== null && st.refManual !== undefined ? st.refManual : Math.round(this.refStage(st.refProg || 0))) + 1)).padStart(2, "0") + " / 03",
      refLineStyle: { strokeDasharray: 1, strokeDashoffset: (1 - (0.28 + (st.refProg || 0) * 0.72)).toFixed(3) },
      refLineStyle2: { strokeDasharray: 1, strokeDashoffset: (1 - (0.18 + (st.refProg || 0) * 0.82)).toFixed(3) },
      s1Tf: rv[0].tf, s1Op: rv[0].op, s1Z: rv[0].z, s1Pe: rv[0].pe,
      s2Tf: rv[1].tf, s2Op: rv[1].op, s2Z: rv[1].z, s2Pe: rv[1].pe,
      s3Tf: rv[2].tf, s3Op: rv[2].op, s3Z: rv[2].z, s3Pe: rv[2].pe,
      s4Tf: rv[3].tf, s4Op: rv[3].op, s4Z: rv[3].z, s4Pe: rv[3].pe,
      s5Tf: rv[4].tf, s5Op: rv[4].op, s5Z: rv[4].z, s5Pe: rv[4].pe,
      revCounter: String(rvIdx + 1).padStart(2, "0") + " / 05",
      revFill: (((rvIdx + 1) / 5) * 100).toFixed(1) + "%",
      revLineStyle: { strokeDasharray: 1, strokeDashoffset: (1 - (0.3 + rvIdx * 0.175)).toFixed(3), transition: "stroke-dashoffset 1.1s " + soft },
      revPrev: () => this.revGo(-1),
      revNext: () => this.revGo(1),
      revHoldOn: () => { this._revHold = true; },
      revHoldOff: () => { this._revHold = false; },
      revTouchStart: (e) => { this._revX = e.touches && e.touches[0] ? e.touches[0].clientX : null; this._revHold = true; },
      revTouchEnd: (e) => {
        this._revHold = false;
        const x0 = this._revX, t = e.changedTouches && e.changedTouches[0];
        if (x0 === null || x0 === undefined || !t) return;
        const dx = t.clientX - x0;
        if (Math.abs(dx) > 44) this.revGo(dx < 0 ? 1 : -1);
        this._revX = null;
      },
      refTrackRef: this.refFor("refTrackEl"),
      refStickyRef: this.refFor("refStickyEl"),
      refStackRef: this.refStackRef,

      contactBlocks: [
        { label: "Adresse", line1: "Industriering Ost 56", line2: "47906 Kempen" },
        { label: "E-Mail", line1: "info@horst-malerbetriebe.de", line2: "" },
        { label: "Öffnungszeiten", line1: "Mo–Fr 09:00–15:00", line2: "Sa/So geschlossen", isHours: true }
      ],
      contactBlocksNoPhone: [
        { label: "Adresse", line1: "Industriering Ost 56", line2: "47906 Kempen" },
        { label: "E-Mail", line1: "info@horst-malerbetriebe.de", line2: "" },
        { label: "Öffnungszeiten", line1: "Mo–Fr 09:00–15:00", line2: "Sa/So geschlossen", isHours: true }
      ],
      openDotColor: openNow ? "#22C55E" : "#EF4444",
      openDotRing: openNow ? "0 0 0 3px rgba(34,197,94,.18)" : "0 0 0 3px rgba(239,68,68,.16)",
      openStatusText: openNow ? "Gerade geöffnet" : "Gerade geschlossen",

      footerCols: this.fc([
        { title: "Kontakt", items: [
