    const near = (a, b) => Math.abs(a - b) < 1;
    if (p && near(p.w, g.w) && near(p.h, g.h) && near(p.overL || 0, g.overL || 0) && near(p.overR || 0, g.overR || 0) && near(p.herz.l, g.herz.l) && near(p.herz.r, g.herz.r) && near(p.herz.b, g.herz.b) && near(p.card.l, g.card.l) && near(p.card.t, g.card.t) && near(p.card.h, g.card.h) && near((p.dabei || {}).r || 0, (g.dabei || {}).r || 0) && near((p.eyebrow || {}).r || 0, (g.eyebrow || {}).r || 0) && near((p.eyebrow || {}).t || 0, (g.eyebrow || {}).t || 0)) return;
