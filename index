      themen: this.topicData().map((t, i) => {
        const rel = i - (st.themaIndex || 0);
        const on = rel === 0;
        return Object.assign({}, t, {
          paneStyle: {
            gridArea: "1/1",
            display: "flex",
            flexDirection: "column",
            alignItems: "flex-start",
            gap: "clamp(13px,1.25cqw,20px)",
            transition: "opacity .55s cubic-bezier(.22,1,.36,1), transform .75s cubic-bezier(.22,1,.36,1)",
            opacity: on ? 1 : 0,
            transform: on ? "translateX(0)" : "translateX(" + (rel < 0 ? -30 : 30) + "px)",
            pointerEvents: on ? "auto" : "none"
          },
          imgStyle: {
            gridArea: "1/1",
            position: "relative",
            width: "min(100%,clamp(220px,22cqw,352px))",
            aspectRatio: "0.68",
            borderRadius: "24px",
            overflow: "hidden",
            background: "var(--paper-tint)",
            boxShadow: "0 24px 52px rgba(21,18,59,.15)",
            transition: "opacity .65s cubic-bezier(.22,1,.36,1), transform .8s cubic-bezier(.22,1,.36,1)",
            opacity: on ? 1 : 0,
            transform: on ? "translateX(0) scale(1)" : "translateX(" + (rel < 0 ? -22 : 22) + "px) scale(.965)",
            pointerEvents: on ? "auto" : "none"
          },
          tickStyle: {
            display: "block",
            width: "clamp(40px,4.88cqw,78px)",
            height: "2px",
            background: on ? "#EB5D0B" : "var(--line-3)",
            transition: "background .35s ease"
          },
          labelStyle: {
            fontSize: "10.5px",
            fontWeight: 700,
            letterSpacing: "0.16em",
            textTransform: "uppercase",
            color: on ? "#15123B" : "#8C889F",
            transition: "color .35s ease"
          },
          go: () => this.goTopic(i)
        });
      }),
      curLabel: String((st.themaIndex || 0) + 1).padStart(2, "0") + " / " + String(this.topicData().length).padStart(2, "0"),
      // Ring läuft als Fortschrittsanzeige mit dem Autoplay mit; wechselnder
      // Keyframe-Name startet die Animation bei jedem Slide neu.
      ringStyle: {
        animation: ((st.themaIndex || 0) % 2 ? "v3ringb " : "v3ring ") + this.TOPIC_MS / 1000 + "s linear both"
      },
      topicPrev: () => { const n = this.topicData().length; this.goTopic(((st.themaIndex || 0) + n - 1) % n); },
      topicNext: () => { const n = this.topicData().length; this.goTopic(((st.themaIndex || 0) + 1) % n); },
      swipeStart: (e) => { this.swX = e.touches && e.touches[0] ? e.touches[0].clientX : null; },
      swipeEnd: (e) => {
        const t = e.changedTouches && e.changedTouches[0];
        if (this.swX == null || !t) return;
        const d = t.clientX - this.swX;
        this.swX = null;
        if (Math.abs(d) < 46) return;
        const n = this.topicData().length;
        this.goTopic(((this.state.themaIndex || 0) + (d < 0 ? 1 : n - 1)) % n);
      },

      swatches: ["#15123B", "#EB5D0B", "#C9CBBF", "#8A9A9B", "#E4DCCF", "#F6F4F1"],
