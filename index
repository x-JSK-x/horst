  // durchlaufen ist (nicht erst bei einer Richtungsumkehr) — exakt an der
  // Stelle, an der die Sticky-Pinnung ohnehin gleich lösen würde, ist der
  // sichtbare Frame unverändert, daher kein Sprung. Danach bleibt beim
  // Zurückscrollen nichts mehr zu erneut zu pinnen.
  syncRefBypass() {
    const tr = this.refTrackEl, sk = this.refStickyEl;
    if (!tr || !sk) return;
    if (getComputedStyle(sk).position !== "sticky") {
      if (this._refCollapsed) { this._refCollapsed = false; tr.style.height = ""; }
      return;
    }
    const rect = tr.getBoundingClientRect();
    const vh = window.innerHeight || 0;
    if (this._refCollapsed) {
      // erst wieder freigeben, wenn die Bahn komplett unter dem Viewport liegt
      if (rect.top >= vh) { this._refCollapsed = false; this._refReset = false; tr.style.height = ""; }
      return;
    }
    const stickyTop = parseFloat(getComputedStyle(sk).top) || 0;
    const done = rect.bottom <= stickyTop + sk.offsetHeight + 1;
    if (!done) return;
    const delta = tr.offsetHeight - sk.offsetHeight;
    if (delta <= 40) return;
    const host = this.scrollHost();
    this._refCollapsed = true;
    tr.style.height = sk.offsetHeight + "px";
    if (host) {
      // html hat scroll-behavior:smooth -> eine direkte scrollTop-Zuweisung würde
      // sonst animiert nachlaufen und wie ein "automatisches" Zurückspringen wirken.
      const htmlEl = document.documentElement;
      const prevBehavior = htmlEl.style.scrollBehavior;
      htmlEl.style.scrollBehavior = "auto";
      host.scrollTop = Math.max(0, host.scrollTop - delta);
      requestAnimationFrame(() => { htmlEl.style.scrollBehavior = prevBehavior; });
    }
  }

  syncRefProg() {
    const tr = this.refTrackEl, sk = this.refStickyEl;
    if (!tr || !sk) return;
    // Mobile Swipe-Bahn: kein Pinning, keine Scroll-Steuerung, Auswahl bleibt.
    if (this.refHoriz()) {
      if ((this.state.refProg || 0) !== 0) this.setState({ refProg: 0 });
      return;
    }
    this.syncRefBypass();
    // Weit unterhalb der Section: Sequenz auf Projekt 01 zurücksetzen,
    // damit man beim Zurückkommen wieder frei wählen kann.
    const trRect = tr.getBoundingClientRect();
    if (trRect.bottom < -(window.innerHeight || 800) * 0.6) {
      this._refReset = true;
      if ((this.state.refProg || 0) !== 0 || this.state.refManual !== null) {
        this.setState({ refProg: 0, refManual: null });
      }
      return;
    }
    const span = tr.offsetHeight - sk.offsetHeight;
    if (span <= 40) {
      const v = (this._refCollapsed && !this._refReset) ? 1 : 0;
      if (this.state.refProg !== v) this.setState({ refProg: v });
      return;
    }
    const top = parseFloat(getComputedStyle(sk).top) || 0;
    const p = Math.min(1, Math.max(0, (top - tr.getBoundingClientRect().top) / span));
    // Manuelle Auswahl nur bei echter Scrollbewegung des Nutzers aufheben.
    if (this.state.refManual !== null && Math.abs((window.scrollY || 0) - (this._refClickY || 0)) > 6) {
      this.setState({ refManual: null });
    }
    if (Math.abs((this.state.refProg || 0) - p) > 0.0015) this.setState({ refProg: p });
  }

