  // Scroll-Container auflösen: je nach Host scrollt html oder body.
  scrollHost() {
    const de = document.scrollingElement || document.documentElement;
    if (de && de.scrollTop > 0) return de;
    const b = document.body;
    if (b && b.scrollTop > 0) return b;
    if (de && de.scrollHeight > de.clientHeight + 1) return de;
    return b || de;
  }

